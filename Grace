import matplotlib.pyplot as plt
import numpy as np

# Data
zones = ['a', 'b', 'c', 'd', 'e', 'f']
pahs = [
    'acenaphthylene', 
    'benzo(a)pyrene', 
    'benzo(b)fluoranthene', 
    'fluoranthene', 
    'fluorene', 
    'indeno(1,2,3cd)pyrene', 
    'phenanthrene', 
    'pyrene', 
    'benzo(ghi)perylene'
]

zone_data = {
    'a': [3.30, 0.16, 2.63, 0.88, 0.32, 0.35, 2.34, 1.97, 2.49],
    'b': [6.53, 0.28, 4.00, 1.34, 0.49, 0.53, 3.56, 2.99, 3.79],
    'c': [3.46, 0.22, 2.12, 0.71, 0.26, 0.28, 1.89, 1.59, 2.01],
    'd': [4.47, 0.34, 2.74, 0.92, 0.33, 0.37, 2.44, 2.05, 2.60],
    'e': [6.67, 0.28, 4.09, 1.37, 0.50, 0.54, 3.64, 3.06, 3.87],
    'f': [3.74, 0.15, 2.29, 0.77, 0.28, 0.31, 2.04, 1.72, 2.17]
}

# Plot settings
plt.style.use('seaborn')
colors = plt.cm.tab20.colors  # Color palette for PAHs

# Generate plots for each zone
for zone in zones:
    data = zone_data[zone]
    
    # --- Bar Chart ---
    plt.figure(figsize=(12, 6))
    bars = plt.bar(pahs, data, color=colors)
    plt.title(f'PAH Concentrations in Zone {zone.upper()} (mg/kg)', fontsize=14)
    plt.ylabel('Concentration (mg/kg)', fontsize=12)
    plt.xticks(rotation=45, ha='right', fontsize=10)
    plt.grid(axis='y', alpha=0.5)
    
    # Save bar chart
    plt.tight_layout()
    plt.savefig(f'bar_chart_zone_{zone}.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    # --- Pie Chart ---
    plt.figure(figsize=(10, 8))
    wedges, texts, autotexts = plt.pie(
        data, 
        labels=pahs, 
        colors=colors,
        autopct='%1.1f%%',
        startangle=90,
        pctdistance=0.85,
        textprops={'fontsize': 8}
    )
    plt.title(f'PAH Composition in Zone {zone.upper()}', fontsize=14)
    
    # Save pie chart
    plt.tight_layout()
    plt.savefig(f'pie_chart_zone_{zone}.png', dpi=300, bbox_inches='tight')
    plt.close()

print("Charts generated successful
